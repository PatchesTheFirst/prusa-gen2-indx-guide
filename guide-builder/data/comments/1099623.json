[{"id": 102500, "post_id": 1099623, "parent": 0, "user": "mike2060", "user_id": 98391, "date": "2026-09-25 18:47:37", "date_gmt": "2026-09-25 16:47:37", "date_gmt_iso": "2026-09-25T16:47:37+00:00", "content": "Why can&#039;t we just unscrew the LED bar, tuck the cable in, screw the bar back in? Cable would stay inside then", "type": "comment", "role": "visitor", "replies": [{"id": 102764, "post_id": 1099623, "parent": 102500, "user": "Malatoke", "user_id": 56941, "date": "2026-09-28 23:47:26", "date_gmt": "2026-09-28 21:47:26", "date_gmt_iso": "2026-09-28T21:47:26+00:00", "content": "I tried it your way but there doesn&#039;t seem to be enough room. Easier to tuck from behind.", "type": "comment", "role": "visitor", "replies": []}]}, {"id": 101049, "post_id": 1099623, "parent": 0, "user": "tomtomav", "user_id": 212164, "date": "2026-09-09 16:33:59", "date_gmt": "2026-09-09 14:33:59", "date_gmt_iso": "2026-09-09T14:33:59+00:00", "content": "in the third picture here it looks like you did not route the led cable through the last zip tie?", "type": "comment", "role": "visitor", "replies": []}, {"id": 100967, "post_id": 1099623, "parent": 0, "user": "Luis", "user_id": 178130, "date": "2026-09-08 17:04:45", "date_gmt": "2026-09-08 15:04:45", "date_gmt_iso": "2026-09-08T15:04:45+00:00", "content": "https://help.prusa3d.com/guide/4-heatbed-upgrade_1110680#1110931", "type": "comment", "role": "visitor", "replies": []}, {"id": 100593, "post_id": 1099623, "parent": 0, "user": "Probe3254", "user_id": 86985, "date": "2026-09-05 16:53:46", "date_gmt": "2026-09-05 14:53:46", "date_gmt_iso": "2026-09-05T14:53:46+00:00", "content": "Route the cables through the rectangular cutout (blue) before tightening the last zip tie, it will make routing easier. Also route the sensor cable first then the RGB LED.", "type": "comment", "role": "visitor", "replies": []}, {"id": 100351, "post_id": 1099623, "parent": 0, "user": "Crocmagnon", "user_id": 60682, "date": "2026-09-03 13:45:27", "date_gm