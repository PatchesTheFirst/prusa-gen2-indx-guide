, "user_id": 146433, "date": "2026-09-09 21:08:57", "date_gmt": "2026-09-09 19:08:57", "date_gmt_iso": "2026-09-09T19:08:57+00:00", "content": "5.5mm spinner all day long", "type": "comment", "role": "visitor", "replies": []}, {"id": 100889, "post_id": 1106106, "parent": 0, "user": "Steve", "user_id": 75717, "date": "2026-09-07 21:02:50", "date_gmt": "2026-09-07 19:02:50", "date_gmt_iso": "2026-09-07T19:02:50+00:00", "content": "This is to add the third screw holding the bottom spool holders. I found it simpler just use long nose pliers to hold the nut", "type": "comment", "role": "visitor", "replies": [{"id": 100982, "post_id": 1106106, "parent": 100889, "user": "sworcester", "user_id": 155744, "date": "2026-09-08 21:02:42", "date_gmt": "2026-09-08 19:02:42", "date_gmt_iso": "2026-09-08T19:02:42+00:00", "content": "5.5mm nut driver for the win", "type": "comment", "role": "visitor", "replies": []}]}]