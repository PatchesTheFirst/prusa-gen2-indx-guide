[{"id": 103315, "post_id": 1106795, "parent": 0, "user": "John Scott", "user_id": 175337, "date": "2026-10-08 00:02:38", "date_gmt": "2026-10-07 22:02:38", "date_gmt_iso": "2026-10-07T22:02:38+00:00", "content": "For the nuts at the back, the arrow on the tool should point away from you towards the back of the machine. You can feel it catch the edge and then slide it up.", "type": "comment", "role": "visitor", "replies": []}, {"id": 102594, "post_id": 1106795, "parent": 0, "user": "Stephen", "user_id": 183927, "date": "2026-09-26 17:58:10", "date_gmt": "2026-09-26 15:58:10", "date_gmt_iso": "2026-09-26T15:58:10+00:00", "content": "Given that the last picture was wrong I&#039;m guessing this one is wrong as well...", "type": "comment", "role": "visitor", "replies": []}, {"id": 102412, "post_id": 1106795, "parent": 0, "user": "PaulJohan", "user_id": 94214, "date": "2026-09-24 13:35:14", "date_gmt": "2026-09-24 11:35:14", "date_gmt_iso": "2026-09-24T11:35:14+00:00", "content": "searching with a light I found that turning it uside down and putting the nus on the other side worked for me. probably needs a redesign indeed.", "type": "comment", "role": "visitor", "replies": []}, {"id": 102374, "post_id": 1106795, "parent": 0, "user": "jche", "user_id": 216513, "date": "2026-09-24 01:24:38", "date_gmt": "2026-09-23 23:24:38", "date_gmt_iso": "2026-09-23T23:24:38+00:00", "content": "Edge/ridge alignment wasn&#039;t working well for me. Ended up manually feeling for the screw tip with my finger and &#039;guessing&#039; the relative distance needed to engage the nut. Maybe would try flipping it as other comments mentioned", "type": "comment", "role": "visitor", "replies": []}, {"id": 102205, "post_id": 1106795, "parent": 0, "user": "murpher9", "user_id": 160926, "date": "2026-09-21 18:11:27", "date_gmt": "2026-09-21 16:11:27", "date_gmt_iso": "2026-09-21T16:11:27+00:00", "content": "I could not get the tool to work in the top left corned, using small pliers to hold the nut is MUCH easier", "type": "comment", "role": "visitor", "replies": []}, {"id": 102169, "post_id": 1106795, "parent": 0, "user": "langjai", "user_id": 144023, "date": "2026-09-20 23:30:59", "date_gmt": "2026-09-20 21:30:59", "date_gmt_iso": "2026-09-20T21:30:59+00:00", "content": "yeah. this needs a redesign.", "type": "comment", "role": "visitor", "replies": []}, {"id": 101988, "post_id": 1106795, "parent": 0, "user": "Digital-Twin", "user_id": 2550, "date": "2026-09-19 17:21:33", "date_gmt": "2026-09-19 15:21:33", "date_gmt_iso": "2026-09-19T15:21:33+00:00", "content": "Gonna be honest.  This step sucked.", "type": "comment", "role": "visitor", "replies": []}, {"id": 101342, "post_id": 1106795, "parent": 0, "user": "Mete", "user_id": 14571, "date": "2026-09-12 10:46:45", "date_gmt": "2026-09-12 08:46:45", "date_gmt_iso": "2026-09-12T08:46:45+00:00", "content": "Fix this design please", "type": "comment", "role": "visitor", "replies": []}, {"id": 101091, "post_id": 1106795, "parent": 0, "user": "DGP_Maluco", "user_id": 164611, "date": "2026-09-09 22:16:29", "date_gmt": "2026-09-09 20:16:29", "date_gmt_iso": "2026-09-09T20:16:29+00:00", "content": "I´ve just used curved, pointed pliers, it´s a lot better!", "type": "comment", "role": "visitor", "replies": []}, {"id": 100840, "post_id": 1106795, "parent": 0, "user": "gadget01", "user_id": 143919, "date": "2026-09-07 11:16:57", "date_gmt": "2026-09-07 09:16:57", "date_gmt_iso": "2026-09-07T09:16:57+00:00", "content": "I lost an hour faffing with this damned thing", "type": "comment", "role": "visitor", "replies": []}, {"id": 100686, "post_id": 1106795, "parent": 0, "user": "Probe3254", "user_id": 86985, "date": "2026-09-06 02:43:10", "date_gmt": "2026-09-06 00:43:10", "date_gmt_iso": "2026-09-06T00:43:10+00:00", "content": "Just like the previous step, I find it easier if the tools is flipped upside down to the short end is on the top. Then just look through the holds and line up before inserting the bolt.", "type": "comment", "role": "visitor", "replies": [{"id": 100717, "post_id": 1106795, "parent": 100686, "user": "Markus Svensson", "user_id": 124766, "date": "2026-09-06 14:16:48", "date_gmt": "2026-09-06 12:16:48", "date_gmt_iso": "2026-09-06T12:16:48+00:00", "content": "Thank you, worked so much better!", "type": "comment", "role": "visitor", "replies": []}, {"id": 100981, "post_id": 1106795, "parent": 100686, "user": "sworcester", "user_id": 155744, "date": "2026-09-08 20:53:31", "date_gmt": "2026-09-08 18:53:31", "date_gmt_iso": "2026-09-08T18:53:31+00:00", "content": "That worked perfectly", "type": "comment", "role": "visitor", "replies": []}, {"id": 101166, "post_id": 1106795, "parent": 100686, "user": "NickT_in_SD", "user_id": 214342, "date": "2026-09-10 18:49:16", "date_gmt": "2026-09-10 16:49:16", "date_gmt_iso": "2026-09-10T16:49:16+00:00", "content": "After an hour of failing using the tool the way it is shown in the manual, I flipped it as you suggested it and got it to work first try. The manual should be updated!", "type": "comment", "role": "visitor", "replies": []}]}]