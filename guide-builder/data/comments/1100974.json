[{"id": 102253, "post_id": 1100974, "parent": 0, "user": "cyberjunaid", "user_id": 90528, "date": "2026-09-22 03:07:00", "date_gmt": "2026-09-22 01:07:00", "date_gmt_iso": "2026-09-22T01:07:00+00:00", "content": "Like Luis said, put the square nuts now. Mine kept slipping out so I used M3x6 screws to keep them in play. Hopefully I remember that I am using M3x6 here.", "type": "comment", "role": "visitor", "replies": []}, {"id": 101715, "post_id": 1100974, "parent": 0, "user": "SceneGreen", "user_id": 217932, "date": "2026-09-17 03:09:55", "date_gmt": "2026-09-17 01:09:55", "date_gmt_iso": "2026-09-17T01:09:55+00:00", "content": "Weird that this uses a plastic toolhead mount, where as my gen1+ had a metal mount.. Hopefully it holds up", "type": "comment", "role": "visitor", "replies": []}, {"id": 101128, "post_id": 1100974, "parent": 0, "user": "Luis", "user_id": 178130, "date": "2026-09-10 06:27:23", "date_gmt": "2026-09-10 04:27:23", "date_gmt_iso": "2026-09-10T04:27:23+00:00", "content": "Pro Tip just put the square nut in now instead of that weird position it tells you to later", "type": "comment", "role": "visitor", "replies": []}, {"id": 99684, "post_id": 1100974, "parent": 0, "user": "Pyron", "user_id": 190574, "date": "2026-08-26 11:34:09", "date_gmt": "2026-08-26 09:34:09", "date_gmt_iso": "2026-08-26T09:34:09+00:00", "content": "I only had M3x8b not M3x8bT.\nShouldn&#039;t matter to much...", "type": "comment", "role": "visitor", "replies": []}]