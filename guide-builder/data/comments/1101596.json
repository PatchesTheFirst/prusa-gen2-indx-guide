[{"id": 104065, "post_id": 1101596, "parent": 0, "user": "katespace", "user_id": 144355, "date": "2026-10-21 00:54:20", "date_gmt": "2026-10-20 22:54:20", "date_gmt_iso": "2026-10-20T22:54:20+00:00", "content": "Make sure you tuck the wire behind the fan well. If the cable comes loose and sticks out too far, the toolhead won&#039;t be able to home properly.", "type": "comment", "role": "visitor", "replies": []}, {"id": 100648, "post_id": 1101596, "parent": 0, "user": "sworcester", "user_id": 155744, "date": "2026-09-05 22:09:38", "date_gmt": "2026-09-05 20:09:38", "date_gmt_iso": "2026-09-05T20:09:38+00:00", "content": "easier to plug the fan in 1st, then tuck the cable, or at least for my not so nimble fat fingers", "type": "comment", "role": "visitor", "replies": [{"id": 102018, "post_id": 1101596, "parent": 100648, "user": "langjai", "user_id": 144023, "date": "2026-09-19 20:22:13", "date_gmt": "2026-09-19 18:22:13", "date_gmt_iso": "2026-09-19T18:22:13+00:00", "content": "Tweezers are your friends", "type": "comment", "role": "visitor", "replies": [{"id": 103979, "post_id": 1101596, "parent": 102018, "user": "kernelkaribou", "user_id": 228081, "date": "2026-10-18 23:51:35", "date_gmt": "2026-10-18 21:51:35", "date_gmt_iso": "2026-10-18T21:51:35+00:00", "content": "This is the way", "type": "comment", "role": "visitor", "replies": []}]}]}]