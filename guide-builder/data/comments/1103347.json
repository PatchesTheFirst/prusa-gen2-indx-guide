[{"id": 103221, "post_id": 1103347, "parent": 0, "user": "John Scott", "user_id": 175337, "date": "2026-10-05 22:55:54", "date_gmt": "2026-10-05 20:55:54", "date_gmt_iso": "2026-10-05T20:55:54+00:00", "content": "On doing the second set, I found it easier to connect the cover loosely and then feed each PTFE tube through. Easier than trying to hold 4 tubes and sensor cables and the cover and screen into place.", "type": "comment", "role": "visitor", "replies": []}, {"id": 100458, "post_id": 1103347, "parent": 0, "user": "Jim", "user_id": 95032, "date": "2026-09-04 15:42:44", "date_gmt": "2026-09-04 13:42:44", "date_gmt_iso": "2026-09-04T13:42:44+00:00", "content": "In step 60 you will see the order of the tubes from top to bottom is 1, 2, 3, 4.", "type": "comment", "role": "visitor", "replies": [{"id": 100497, "post_id": 1103347, "parent": 100458, "user": "tim", "user_id": 181371, "date": "2026-09-04 22:45:39", "date_gmt": "2026-09-04 20:45:39", "date_gmt_iso": "2026-09-04T20:45:39+00:00", "content": "thank you!", "type": "comment", "role": "visitor", "replies": []}]}, {"id": 100398, "post_id": 1103347, "parent": 0, "user": "bioxz", "user_id": 176508, "date": "2026-09-03 19:45:10", "date_gmt": "2026-09-03 17:45:10", "date_gmt_iso": "2026-09-03T17:45:10+00:00", "content": "Which tube goes into which channel?", "type": "comment", "role": "visitor", "replies": []}, {"id": 100228, "post_id": 1103347, "parent": 0, "user": "Pri Pri", "user_id": 85213, "date": "2026-09-01 17:31:09", "date_gmt": "2026-09-01 15:31:09", "date_gmt_iso": "2026-09-01T15:31:09+00:00", "content": "Much easier to attach the cover and then slide the tubes in", "type": "comment", "role": "visitor", "replies": [{"id": 101192, "post_id": 1103347, "parent": 100228, "user": "Luis", "user_id": 178130, "date": "2026-09-11 00:03:54", "date_gmt": "2026-09-10 22:03:54", "date_gmt_iso": "2026-09-10T22:03:54+00:00", "content": "Yep ^ this is the way I have no idea why prusa guides are always so backwards", "type": "comment", "role": "visitor", "replies": []}]}]