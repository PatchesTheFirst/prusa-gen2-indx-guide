[{"id": 102159, "post_id": 1099826, "parent": 0, "user": "JanV", "user_id": 169517, "date": "2026-09-20 21:20:14", "date_gmt": "2026-09-20 19:20:14", "date_gmt_iso": "2026-09-20T19:20:14+00:00", "content": "be careful to not over tighten! the nut skips easily in the center hole", "type": "comment", "role": "visitor", "replies": []}, {"id": 101092, "post_id": 1099826, "parent": 0, "user": "vhubbard", "user_id": 53620, "date": "2026-09-09 22:43:05", "date_gmt": "2026-09-09 20:43:05", "date_gmt_iso": "2026-09-09T20:43:05+00:00", "content": "Agreed put in  all 3 nuts now and use tape to keep them in place if they are loose.   Mine were all tight.", "type": "comment", "role": "visitor", "replies": []}, {"id": 100800, "post_id": 1099826, "parent": 0, "user": "btarlton", "user_id": 752, "date": "2026-09-07 00:55:15", "date_gmt": "2026-09-06 22:55:15", "date_gmt_iso": "2026-09-06T22:55:15+00:00", "content": "I would put all three nuts in the bottom of the bed-cable-cover-bottom now since its easier to do while not attached to the heatbed.", "type": "comment", "role": "visitor", "replies": []}, {"id": 100543, "post_id": 1099826, "parent": 0, "user": "coffeeFueledDiy", "user_id": 184633, "date": "2026-09-05 08:53:43", "date_gmt": "2026-09-05 06:53:43", "date_gmt_iso": "2026-09-05T06:53:43+00:00", "content": "Use the pull-through method to seat the nut to protect pulling the nut into place while the screw is against the heatbed.", "type": "comment", "role": "visitor", "replies": []}]