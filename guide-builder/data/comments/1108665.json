[{"id": 105205, "post_id": 1108665, "parent": 0, "user": "chuckwolber", "user_id": 187151, "date": "2026-11-08 00:17:22", "date_gmt": "2026-11-07 23:17:22", "date_gmt_iso": "2026-11-07T23:17:22+00:00", "content": "An installation guide with a warning should also include steps to address the problem.\n\nI was able to find this:\n\nhttps://forum.prusa3d.com/forum/prusa-indx-how-do-i-print-this-printing-help/petg-oozing-and-impeding-bed-probing\n\nNote: I also replied to the first comment with similar information. I am adding a top-level comment to bring further attention to the problem.", "type": "comment", "role": "visitor", "replies": []}, {"id": 103185, "post_id": 1108665, "parent": 0, "user": "John", "user_id": 6388, "date": "2026-10-05 09:04:57", "date_gmt": "2026-10-05 07:04:57", "date_gmt_iso": "2026-10-05T07:04:57+00:00", "content": "My M3x4 screws are M3x5 - hopefully the additional 1mm won&#039;t interfere with anything.....", "type": "comment", "role": "visitor", "replies": [{"id": 104854, "post_id": 1108665, "parent": 103185, "user": "Tailgunner", "user_id": 85858, "date": "2026-11-03 02:30:15", "date_gmt": "2026-11-03 01:30:15", "date_gmt_iso": "2026-11-03T01:30:15+00:00", "content": "i didnt hae M3x4, used the M3x6, the location where its installed, it wont interfere with anything. carefull not to get caught in it later i guess", "type": "comment", "role": "visitor", "replies": []}]}, {"id": 101111, "post_id": 1108665, "parent": 0, "user": "David R. Campbell", "user_id": 153783, "date": "2026-09-10 00:55:26", "date_gmt": "2026-09-09 22:55:26", "date_gmt_iso": "2026-09-09T22:55:26+00:00", "content": "&quot;Avoid touching or damaging the rectangular sensing area&quot;  \nIf I do touch it, do I clean it with IPA?", "type": "comment", "role": "visitor", "replies": [{"id": 102884, "post_id": 1108665, "parent": 101111, "user": "SuperCuriousFox", "user_id": 154558, "date": "2026-10-01 23:54:35", "date_gmt": "2026-10-01 21:54:35", "date_gmt_iso": "2026-10-01T21:54:35+00:00", "content": "No IPA, just soapy water.", "type": "comment", "role": "visitor", "replies": [{"id": 104771, "post_id": 1108665, "parent": 102884, "user": "Mark_from_Briz", "user_id": 197850, "date": "2026-11-02 04:46:01", "date_gmt": "2026-11-02 03:46:01", "date_gmt_iso": "2026-11-02T03:46:01+00:00", "content": "Yea i can&#039;t imagine an Indian Pale Ale would be any good for it", "type": "comment", "role": "visitor", "replies": [{"id": 105237, "post_id": 1108665, "parent": 104771, "user": "Pliind", "user_id": 155638, "date": "2026-11-08 11:50:33", "date_gmt": "2026-11-08 10:50:33", "date_gmt_iso": "2026-11-08T10:50:33+00:00", "content": "I hope you are joking…..", "type": "comment", "role": "visitor", "replies": []}]}]}]}, {"id": 100803, "post_id": 1108665, "parent": 0, "user": "SveeP", "user_id": 166139, "date": "2026-09-07 01:12:35", "date_gmt": "2026-09-06 23:12:35", "date_gmt_iso": "2026-09-06T23:12:35+00:00", "content": "My M3x4 screws are black also. I had an Mk4 and upgraded to CoreOne.", "type": "comment", "role": "visitor", "replies": [{"id": 100815, "post_id": 1108665, "parent": 100803, "user": "Ben Dover", "user_id": 46415, "date": "2026-09-07 03:26:17", "date_gmt": "2026-09-07 01:26:17", "date_gmt_iso": "2026-09-07T01:26:17+00:00", "content": "same", "type": "comment", "role": "visitor", "replies": []}, {"id": 100904, "post_id": 1108665, "parent": 100803, "user": "jabdoa", "user_id": 184679, "date": "2026-09-07 23:07:28", "date_gmt": "2026-09-07 21:07:28", "date_gmt_iso": "2026-09-07T21:07:28+00:00", "content": "Same for me. Original had a C1+.", "type": "comment", "role": "visitor", "replies": []}, {"id": 102221, "post_id": 1108665, "parent": 100803, "user": "murpher9", "user_id": 160926, "date": "2026-09-21 21:45:26", "date_gmt": "2026-09-21 19:45:26", "date_gmt_iso": "2026-09-21T19:45:26+00:00", "content": "same", "type": "comment", "role": "visitor", "replies": []}, {"id": 102291, "post_id": 1108665, "parent": 100803, "user": "JanV", "us