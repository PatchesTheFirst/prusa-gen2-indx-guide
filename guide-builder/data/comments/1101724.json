[{"id": 102021, "post_id": 1101724, "parent": 0, "user": "langjai", "user_id": 144023, "date": "2026-09-19 20:34:37", "date_gmt": "2026-09-19 18:34:37", "date_gmt_iso": "2026-09-19T18:34:37+00:00", "content": "Run the cable through the grommet, but don&#039;t install the grommet yet. Insert the grommet later when the cable is in position.", "type": "comment", "role": "visitor", "replies": []}, {"id": 101718, "post_id": 1101724, "parent": 0, "user": "SceneGreen", "user_id": 217932, "date": "2026-09-17 04:07:44", "date_gmt": "2026-09-17 02:07:44", "date_gmt_iso": "2026-09-17T02:07:44+00:00", "content": "I had no grommet in the lower hole from my core one+ kit, and this upgrade also did not include one. Hopefully the rough metel edge doesn&#039;t rub through!", "type": "comment", "role": "visitor", "replies": []}, {"id": 99689, "post_id": 1101724, "parent": 0, "user": "0xTJ", "user_id": 175317, "date": "2026-08-26 14:25:57", "date_gmt": "2026-08-26 12:25:57", "date_gmt_iso": "2026-08-26T12:25:57+00:00", "content": "My printer didn&#039;t have a grommet on the bottom hole, it wasn&#039;t added in the assembly instructions. However, the Core ONE + kit did include spare grommets for the unused holes, so make sure to add that before putting cables through that hole.", "type": "comment", "role": "visitor", "replies": [{"id": 99834, "post_id": 1101724, "parent": 99689, "user": "Spin360", "user_id": 90158, "date": "2026-08-28 23:19:11", "date_gmt": "2026-08-28 21:19:11", "date_gmt_iso": "2026-08-28T21:19:11+00:00", "content": "Exactly the same here, used spare grommet.", "type": "comment", "role": "visitor", "replies": []}, {"id": 99856, "post_id": 1101724, "parent": 99689, "user": "thorthekitten", "user_id": 205008, "date": "2026-08-29 07:23:53", "date_gmt": "2026-08-29 05:23:53", "date_gmt_iso": "2026-08-29T05:23:53+00:00", "content": "Same problem here, same solution. My hoarding finally pays off.", "type": "comment", "role": "visitor", "replies": []}, {"id": 99930, "post_id": 1101724, "parent": 99689, "user": "reasonableprinting", "user_id": 116608, "date": "2026-08-30 00:33:53", "date_gmt": "2026-08-29 22:33:53", "date_gmt_iso": "2026-08-29T22:33:53+00:00", "content": "Same", "type": "comment", "role": "visitor", "replies": []}, {"id": 100654, "post_id": 1101724, "parent": 99689, "user": "bretcobrageek", "user_id": 94091, "date": "2026-09-05 22:30:13", "date_gmt": "2026-09-05 20:30:13", "date_gmt_iso": "2026-09-05T20:30:13+00:00", "content": "Same here.  I didn&#039;t get the official + upgrade package.  I did find a spare in the MK4 to core one upgrade stuff.", "type": "comment", "role": "visitor", "replies": []}, {"id": 102263, "post_id": 1101724, "parent": 99689, "user": "cyberjunaid", "user_id": 90528, "date": "2026-09-22 05:39:35", "date_gmt": "2026-09-22 03:39:35", "date_gmt_iso": "2026-09-22T03:39:35+00:00", "content": "Thanks for the tip!", "type": "comment", "role": "visitor", "replies": []}]}]