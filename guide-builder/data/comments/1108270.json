[{"id": 100731, "post_id": 1108270, "parent": 0, "user": "Probe3254", "user_id": 86985, "date": "2026-09-06 16:02:39", "date_gmt": "2026-09-06 14:02:39", "date_gmt_iso": "2026-09-06T14:02:39+00:00", "content": "As with other steps in this chapter, pre-threading the cover-knobs will save you.", "type": "comment", "role": "visitor", "replies": []}, {"id": 99680, "post_id": 1108270, "parent": 0, "user": "Dominik Chuchlík", "user_id": 189504, "date": "2026-08-26 10:53:47", "date_gmt": "2026-08-26 08:53:47", "date_gmt_iso": "2026-08-26T08:53:47+00:00", "content": "M3x8 is too short to engage INDX-C1-cover-knob, use M3x10", "type": "comment", "role": "visitor", "replies": [{"id": 99711, "post_id": 1108270, "parent": 99680, "user": "Pyron", "user_id": 190574, "date": "2026-08-26 23:01:03", "date_gmt": "2026-08-26 21:01:03", "date_gmt_iso": "2026-08-26T21:01:03+00:00", "content": "Second that. M3x10 fits much better!", "type": "comment", "role": "visitor", "replies": [{"id": 99731, "post_id": 1108270, "parent": 99711, "user": "MilFej", "user_id": 159177, "date": "2026-08-27 16:42:38", "date_gmt": "2026-08-27 14:42:38", "date_gmt_iso": "2026-08-27T14:42:38+00:00", "content": "Hello, thank you for the comment. We apologize for the confusion, use a M3x10 screw that you removed while disassembling the printer earlier.", "type": "comment", "role": "employee", "replies": []}]}]}]