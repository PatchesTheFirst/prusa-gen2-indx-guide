[{"id": 101594, "post_id": 1149214, "parent": 0, "user": "Seeker", "user_id": 41892, "date": "2026-09-14 18:10:23", "date_gmt": "2026-09-14 16:10:23", "date_gmt_iso": "2026-09-14T16:10:23+00:00", "content": "In case you had issues with larger prints in the past due to grounding( see https://forum.prusa3d.com/forum/prusa-core-one-hardware-firmware-and-software-help/core-one-crash-restart/paged/5/ ) you may need to reaply the motor grounding after reassembling)", "type": "comment", "role": "visitor", "replies": []}, {"id": 101497, "post_id": 1149214, "parent": 0, "user": "Trainman", "user_id": 19597, "date": "2026-09-13 17:53:04", "date_gmt": "2026-09-13 15:53:04", "date_gmt_iso": "2026-09-13T15:53:04+00:00", "content": "Very easy to incorrectly remove rod screws.  Lots of screws to get you easily confused.  Speaking from experience", "type": "comment", "role": "visitor", "replies": []}, {"id": 99676, "post_id": 1149214, "parent": 0, "user": "Pyron", "user_id": 190574, "date": "2026-08-26 09:47:36", "date_gmt": "2026-08-26 07:47:36", "date_gmt_iso": "2026-08-26T07:47:36+00:00", "content": "The pink screws, which secure the motor, are M3x35 not M3x30!", "type": "comment", "role": "visitor", "replies": [{"id": 100970, "post_id": 1149214, "parent": 99676, "user": "k4rl5m1th", "user_id": 146433, "date": "2026-09-08 17:29:06", "date_gmt": "2026-09-08 15:29:06", "date_gmt_iso": "2026-09-08T15:29:06+00:00", "content": "confirmed", "type": "comment", "role": "visitor", "replies": []}]}]