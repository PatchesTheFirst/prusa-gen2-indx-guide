[{"id": 102383, "post_id": 1098123, "parent": 0, "user": "A_Str8", "user_id": 31384, "date": "2026-09-24 04:35:42", "date_gmt": "2026-09-24 02:35:42", "date_gmt_iso": "2026-09-24T02:35:42+00:00", "content": "Press and hold the collet down with one hand. With the other hand, press the tube down in the same direction first, then pull it out.", "type": "comment", "role": "visitor", "replies": [{"id": 103247, "post_id": 1098123, "parent": 102383, "user": "Uncle Jessy", "user_id": 11991, "date": "2026-10-06 05:21:02", "date_gmt": "2026-10-06 03:21:02", "date_gmt_iso": "2026-10-06T03:21:02+00:00", "content": "Much appreciated for that tip! Was having a heck of a time trying to get it to release", "type": "comment", "role": "visitor", "replies": []}]}, {"id": 100873, "post_id": 1098123, "parent": 0, "user": "Patrik Hadorn", "user_id": 197163, "date": "2026-09-07 18:28:55", "date_gmt": "2026-09-07 16:28:55", "date_gmt_iso": "2026-09-07T16:28:55+00:00", "content": "The snap river remover was what allowed me to remove it. Pressing with my fingers wasn&#039;t enough", "type": "comment", "role": "visitor", "replies": []}, {"id": 100507, "post_id": 1098123, "parent": 0, "user": "Ben Dover", "user_id": 46415, "date": "2026-09-04 23:25:58", "date_gmt": "2026-09-04 21:25:58", "date_gmt_iso": "2026-09-04T21:25:58+00:00", "content": "I used my needle nose pliers to push down on the black collet (instead of fingers) and then it came out very easily. Wouldn&#039;t come out when I pressed down with my fingers.", "type": "comment", "role": "visitor", "replies": [{"id": 101994, "post_id": 1098123, "parent": 100507, "user": "Ch4s3r", "user_id": 190409, "date": "2026-09-19 17:59:01", "date_gmt": "2026-09-19 15:59:01", "date_gmt_iso": "2026-09-19T15:59:01+00:00", "content": "Same for me. Worked great with pliers.", "type": "comment", "role": "visitor", "replies": []}, {"id": 103036, "post_id": 1098123, "parent": 100507, "user": "4nozzle", "user_id": 105126, "date": "2026-10-03 23:09:22", "date_gmt": "2026-10-03 21:09:22", "date_gmt_iso": "2026-10-03T21:09:22+00:00", "content": "This worked great, thanks", "type": "comment", "role": "visitor", "replies": []}]}, {"id": 100483, "post_id": 1098123, "parent": 0, "user": "dr_blue", "user_id": 176546, "date": "2026-09-04 20:46:31", "date_gmt": "2026-09-04 18:46:31", "date_gmt_iso": "2026-09-04T18:46:31+00:00", "content": "I couldn&#039;t get the PTFE tube out of the fitting, no matter how hard I pulled.\n\nAfter unscrewing the M5-4 fitting in the next step I had more leverage and it popped off easily.", "type": "comment", "role": "visitor", "replies": [{"id": 101544, "post_id": 1098123, "parent": 100483, "user": "Jason K", "user_id": 160262, "date": "2026-09-14 01:47:35", "date_gmt": "2026-09-13 23:47:35", "date_gmt_iso": "2026-09-13T23:47:35+00:00", "content": "Same. Great tip. Thanks!", "type": "comment", "role": "visitor", "replies": []}]}]