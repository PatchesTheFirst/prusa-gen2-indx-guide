[{"id": 105380, "post_id": 1103174, "parent": 0, "user": "NJJerrySmith", "user_id": 208, "date": "2026-11-10 01:37:48", "date_gmt": "2026-11-10 00:37:48", "date_gmt_iso": "2026-11-10T00:37:48+00:00", "content": "If you have the side plexiglass panel removed, remove the bowden tube guide from the Y-Axis motor before you attach this all", "type": "comment", "role": "visitor", "replies": []}, {"id": 103648, "post_id": 1103174, "parent": 0, "user": "4nozzle", "user_id": 105126, "date": "2026-10-12 16:07:32", "date_gmt": "2026-10-12 14:07:32", "date_gmt_iso": "2026-10-12T14:07:32+00:00", "content": "One screw to hold them all… seems like the weakest link in the upgrade so far.", "type": "comment", "role": "visitor", "replies": [{"id": 103736, "post_id": 1103174, "parent": 103648, "user": "jeff", "user_id": 185444, "date": "2026-10-14 07:03:11", "date_gmt": "2026-10-14 05:03:11", "date_gmt_iso": "2026-10-14T05:03:11+00:00", "content": "Yeah this is both concerning and annoying for anyone that had their printer in a tighter space...", "type": "comment", "role": "visitor", "replies": []}, {"id": 105858, "post_id": 1103174, "parent": 103648, "user": "ofthedove", "user_id": 189888, "date": "2026-11-16 03:38:02", "date_gmt": "2026-11-16 02:38:02", "date_gmt_iso": "2026-11-16T02:38:02+00:00", "content": "It sticks out so far too, seems like it would be really easy to snag on something and break off.", "type": "comment", "role": "visitor", "replies": []}]}, {"id": 100727, "post_id": 1103174, "parent": 0, "user": "Ben Dover", "user_id": 46415, "date": "2026-09-06 15:49:54", "date_gmt": "2026-09-06 13:49:54", "date_gmt_iso": "2026-09-06T13:49:54+00:00", "content": "It says fully tighten, but be careful your screwing into plastic.", "type": "comment", "role": "visitor", "replies": []}]