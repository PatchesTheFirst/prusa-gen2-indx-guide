[{"id": 104258, "post_id": 1099715, "parent": 0, "user": "mrbunky13", "user_id": 36916, "date": "2026-10-24 17:07:41", "date_gmt": "2026-10-24 15:07:41", "date_gmt_iso": "2026-10-24T15:07:41+00:00", "content": "The E1 piece looks to have a slightly larger opening on the side, presumably to accommodate the cable for the offset sensor in addition to the LED cable, so needs to be used to prevent pinching those wires.", "type": "comment", "role": "visitor", "replies": []}, {"id": 103898, "post_id": 1099715, "parent": 0, "user": "Neal", "user_id": 136400, "date": "2026-10-17 19:29:51", "date_gmt": "2026-10-17 17:29:51", "date_gmt_iso": "2026-10-17T17:29:51+00:00", "content": "Shouldn&#039;t  this be the newer Gen2 bed set up?", "type": "comment", "role": "visitor", "replies": []}, {"id": 101886, "post_id": 1099715, "parent": 0, "user": "OversizedHat", "user_id": 10981, "date": "2026-09-19 02:10:50", "date_gmt": "2026-09-19 00:10:50", "date_gmt_iso": "2026-09-19T00:10:50+00:00", "content": "There&#039;s potential for confusion here - I&#039;m assuming that Gen2 upgraders should ignore the part about the 8mm spacer here, since we already placed the new 10mm one, but it has the potential to throw people off since something like this were the guides conflict/interact would normally be noted.", "type": "comment", "role": "visitor", "replies": []}, {"id": 99659, "post_id": 1099715, "parent": 0, "user": "Trikke", "user_id": 119794, "date": "2026-08-25 20:17:33", "date_gmt": "2026-08-25 18:17:33", "date_gmt_iso": "2026-08-25T18:17:33+00:00", "content": "8 mm or 10 mm heatbed spacer?", "type": "comment", "role": "visitor", "replies": [{"id": 100436, "post_id": 1099715, "parent": 99659, "user": "tim", "user_id": 181371, "date": "2026-09-04 05:03:36", "date_gmt": "2026-09-04 03:03:36", "date_gmt_iso": "2026-09-04T03:03:36+00:00", "content": "For Gen2, the 10mm spacer", "type": "comment", "role": "visitor", "replies": [{"id": 100537, "post_id": 1099715, "parent": 100436, "user": "Be