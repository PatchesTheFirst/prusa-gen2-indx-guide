[{"id": 101210, "post_id": 1101428, "parent": 0, "user": "Egress", "user_id": 191032, "date": "2026-09-11 03:50:25", "date_gmt": "2026-09-11 01:50:25", "date_gmt_iso": "2026-09-11T01:50:25+00:00", "content": "Make sure there are no parts stuck inside the fan shroud. Mine had another 3d printed part inside.", "type": "comment", "role": "visitor", "replies": []}, {"id": 99692, "post_id": 1101428, "parent": 0, "user": "clivebradshaw", "user_id": 6621, "date": "2026-08-26 16:17:21", "date_gmt": "2026-08-26 14:17:21", "date_gmt_iso": "2026-08-26T14:17:21+00:00", "content": "There are no threads in the INDX tool head to allow the bottom two screws to hold the fan shroud on; a solution is to cut down a M3x40 screw and bolt through with a nut on the opposite side.", "type": "comment", "role": "visitor", "replies": [{"id": 99832, "post_id": 1101428, "parent": 99692, "user": "Spin360", "user_id": 90158, "date": "2026-08-28 21:47:24", "date_gmt": "2026-08-28 19:47:24", "date_gmt_iso": "2026-08-28T19:47:24+00:00", "content": "Mine does...", "type": "comment", "role": "visitor", "replies": []}, {"id": 99851, "post_id": 1101428, "parent": 99692, "user": "thorthekitten", "user_id": 205008, "date": "2026-08-29 07:05:53", "date_gmt": "2026-08-29 05:05:53", "date_gmt_iso": "2026-08-29T05:05:53+00:00", "content": "two square nuts are suppose to go in there and catch these screws. I also missed then but there is a spot for them", "type": "comment", "role": "visitor", "replies": [{"id": 100644, "post_id": 1101428, "parent": 99851, "user": "sworcester", "user_id": 155744, "date": "2026-09-05 22:00:58", "date_gmt": "2026-09-05 20:00:58", "date_gmt_iso": "2026-09-05T20:00:58+00:00", "content": "they fall out real easy too", "type": "comment", "role": "visitor", "replies": [{"id": 101615, "post_id": 1101428, "parent": 100644, "user": "ftess", "user_id": 72513, "date": "2026-09-15 05:33:16", "date_gmt": "2026-09-15 03:33:16", "date_gmt_iso": "2026-09-15T03:33:16+00:00", "content": "Go back and read the comment for step 11 to hold the nuts in.", "type": "comment", "role": "visitor", "replies": []}]}]}, {"id": 100432, "post_id": 1101428, "parent": 99692, "user": "tdcsf", "user_id": 82675, "date": "2026-09-04 03:26:02", "date_gmt": "2026-09-04 01:26:02", "date_gmt_iso": "2026-09-04T01:26:02+00:00", "content": "Step 11", "type": "comment", "role": "visitor", "replies": []}]}]