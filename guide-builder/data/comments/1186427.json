[{"id": 102525, "post_id": 1186427, "parent": 0, "user": "Stephen", "user_id": 183927, "date": "2026-09-26 03:04:13", "date_gmt": "2026-09-26 01:04:13", "date_gmt_iso": "2026-09-26T01:04:13+00:00", "content": "1/4 turn backoff was not enough", "type": "comment", "role": "visitor", "replies": []}, {"id": 101975, "post_id": 1186427, "parent": 0, "user": "SceneGreen", "user_id": 217932, "date": "2026-09-19 16:13:11", "date_gmt": "2026-09-19 14:13:11", "date_gmt_iso": "2026-09-19T14:13:11+00:00", "content": "I had to loosen that knob at least a full turn so it could engage, it did move before when installing with a small amount of friction. Once installed I gave the nut another ~1/8th of a turn so the knob engages tighter and I can still get it off/on.", "type": "comment", "role": "visitor", "replies": []}, {"id": 101957, "post_id": 1186427, "parent": 0, "user": "iKriz", "user_id": 168027, "date": "2026-09-19 14:19:59", "date_gmt": "2026-09-19 12:19:59", "date_gmt_iso": "2026-09-19T12:19:59+00:00", "content": "had to loosen it alot more...", "type": "comment", "role": "visitor", "replies": []}, {"id": 99899, "post_id": 1186427, "parent": 0, "user": "PetrichorPete", "user_id": 216512, "date": "2026-08-29 18:51:27", "date_gmt": "2026-08-29 16:51:27", "date_gmt_iso": "2026-08-29T16:51:27+00:00", "content": "The lock screw may need to be loosened slightly to fully lock.", "type": "comment", "role": "visitor", "replies": [{"id": 100770, "post_id": 1186427, "parent": 99899, "user": "jabdoa", "user_id": 184679, "date": "2026-09-06 22:29:50", "date_gmt": "2026-09-06 20:29:50", "date_gmt_iso": "2026-09-06T20:29:50+00:00", "content": "For me as well", "type": "comment", "role": "visitor", "replies": []}, {"id": 101056, "post_id": 1186427, "parent": 99899, "user": "k4rl5m1th", "user_id": 146433, "date": "2026-09-09 17:59:11", "date_gmt": "2026-09-09 15:59:11", "date_gmt_iso": "2026-09-09T15:59:11+00:00", "content": "says back it off 1/4 turn on previous step, works fine then", "ty