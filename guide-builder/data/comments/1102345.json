[{"id": 102753, "post_id": 1102345, "parent": 0, "user": "printor", "user_id": 168386, "date": "2026-09-28 21:10:12", "date_gmt": "2026-09-28 19:10:12", "date_gmt_iso": "2026-09-28T19:10:12+00:00", "content": "was easy enough for me with the norml torx screwdriver for me", "type": "comment", "role": "visitor", "replies": []}, {"id": 102505, "post_id": 1102345, "parent": 0, "user": "Stephen", "user_id": 183927, "date": "2026-09-25 20:37:06", "date_gmt": "2026-09-25 18:37:06", "date_gmt_iso": "2026-09-25T18:37:06+00:00", "content": "the ball headed allen key that came with the printer worked fine for getting it in... but then the wrench was stuck...", "type": "comment", "role": "visitor", "replies": []}, {"id": 102031, "post_id": 1102345, "parent": 0, "user": "langjai", "user_id": 144023, "date": "2026-09-19 21:46:30", "date_gmt": "2026-09-19 19:46:30", "date_gmt_iso": "2026-09-19T19:46:30+00:00", "content": "Took 1 minute with metric 2.5 T-handle metric wrench. I used Park Tool wrench from my bike workshop. I&#039;m compiling a list of actual useful tools to get before doing this upgrade. Will post up front later.", "type": "comment", "role": "visitor", "replies": []}, {"id": 101771, "post_id": 1102345, "parent": 0, "user": "SceneGreen", "user_id": 217932, "date": "2026-09-18 03:51:34", "date_gmt": "2026-09-18 01:51:34", "date_gmt_iso": "2026-09-18T01:51:34+00:00", "content": "Even with the ball end Allen that was just stupid, good way to round out that ball end with how poorly that channel is designed", "type": "comment", "role": "visitor", "replies": [{"id": 102081, "post_id": 1102345, "parent": 101771, "user": "Danshari", "user_id": 127633, "date": "2026-09-20 03:25:05", "date_gmt": "2026-09-20 01:25:05", "date_gmt_iso": "2026-09-20T01:25:05+00:00", "content": "same, totally wrecked, also it sticks down quite a ways", "type": "comment", "role": "visitor", "replies": []}]}, {"id": 101769, "post_id": 1102345, "parent": 0, "user": "Tripp", "user_id": 128982, "date": "2026-09-18 03:22:55", "date_gmt": "2026-09-18 01:22:55", "date_gmt_iso": "2026-09-18T01:22:55+00:00", "content": "That sucked. \nI dont have a ball point metric wrench, so this was a exercise in patience", "type": "comment", "role": "visitor", "replies": [{"id": 102004, "post_id": 1102345, "parent": 101769, "user": "henke", "user_id": 197487, "date": "2026-09-19 18:58:01", "date_gmt": "2026-09-19 16:58:01", "date_gmt_iso": "2026-09-19T16:58:01+00:00", "content": "It came with the core1 kit if you did that..\n\nAnd this is just a problem for americans really :)", "type": "comment", "role": "visitor", "replies": []}]}, {"id": 100663, "post_id": 1102345, "parent": 0, "user": "coffeeFueledDiy", "user_id": 184633, "date": "2026-09-05 23:28:48", "date_gmt": "2026-09-05 21:28:48", "date_gmt_iso": "2026-09-05T21:28:48+00:00", "content": "Don&#039;t remove the right screw if you have the 4-tool version. (That should be moved to the next step.)", "type": "comment", "role": "visitor", "replies": []}, {"id": 100212, "post_id": 1102345, "parent": 0, "user": "StLuke", "user_id": 135815, "date": "2026-09-01 12:34:53", "date_gmt": "2026-09-01 10:34:53", "date_gmt_iso": "2026-09-01T10:34:53+00:00", "content": "there is somebody responsible for this, right? there is a person, who said, ahh f*** it, people will figure it out, just say join both parts by fully tightening the M3x10 screw let people struggle", "type": "comment", "role": "visitor", "replies": [{"id": 100222, "post_id": 1102345, "parent": 100212, "user": "Pri Pri", "user_id": 85213, "date": "2026-09-01 16:44:30", "date_gmt": "2026-09-01 14:44:30", "date_gmt_iso": "2026-09-01T14:44:30+00:00", "content": "Fr! That was a miserable time. Hopefully I never have to remove that because I definitely stopped the head of the screw.", "type": "comment", "role": "visitor", "replies": [{"id": 100257, "post_id": 1102345, "parent": 100222, "user": "etmidust", "user_id": 199369, "date": "2026-09-02 00:59:56", "date_gmt": "2026-09-01 22:59:56", "date_gmt_iso": "2026-09-01T22:59:56+00:00", "content": "You are supposed to use the ball ended Allen key. Super simple and painless with the proper tool.", "type": "comment", "role": "visitor", "replies": [{"id": 101779, "post_id": 1102345, "parent": 100257, "user": "baldrick", "user_id": 160590, "date": "2026-09-18 09:30:50", "date_gmt": "2026-09-18 07:30:49", "date_gmt_iso": "2026-09-18T07:30:49+00:00", "content": "I&#039;ve got a ball ended Allen key.  It was still neither simple nor painless.", "type": "comment", "role": "visitor", "replies": []}, {"id": 102082, "post_id": 1102345, "parent": 100257, "user": "Danshari", "user_id": 127633, "date": "2026-09-20 03:28:44", "date_gmt": "2026-09-20 01:28:44", "date_gmt_iso": "2026-09-20T01:28:44+00:00", "content": "incorrect", "type": "comment", "role": "visitor", "replies": []}]}]}]}, {"id": 99807, "post_id": 1102345, "parent": 0, "user": "z073", "user_id": 31065, "date": "2026-08-28 17:59:18", "date_gmt": "2026-08-28 15:59:18", "date_gmt_iso": "2026-08-28T15:59:18+00:00", "content": "The screw M3x10 seems unnecessary long as it provides into the printer?\n\nThe cutout for the Allen key could be much longer, I can&#039;t fasten the screw.", "type": "comment", "role": "visitor", "replies": [{"id": 100258, "post_id": 1102345, "parent": 99807, "user": "etmidust", "user_id": 199369, "date": "2026-09-02 01:00:38", "date_gmt": "2026-09-01 23:00:38", "date_gmt_iso": "2026-09-01T23:00:38+00:00", "content": "3x8 would work fine but the attempt is to reuse as much as possible.", "type": "comment", "role": "visitor", "replies": [{"id": 102005, "post_id": 1102345, "parent": 100258, "user": "henke", "user_id": 197487, "date": "2026-09-19 18:59:56", "date_gmt": "2026-09-19 16:59:56", "date_gmt_iso": "2026-09-19T16:59:56+00:00", "content": "If you own a prusa machine you should have a box of 400 diffrent lenght m3 screws allready..\n\nOr is that just me?", "type": "comment", "role": "visitor", "replies": []}]}]}]