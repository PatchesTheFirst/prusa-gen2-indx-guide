[{"id": 104266, "post_id": 1111005, "parent": 0, "user": "mrbunky13", "user_id": 36916, "date": "2026-10-24 17:52:08", "date_gmt": "2026-10-24 15:52:08", "date_gmt_iso": "2026-10-24T15:52:08+00:00", "content": "Note that not all alignment tools will be orange.  Mine came printed in black.", "type": "comment", "role": "visitor", "replies": []}, {"id": 103784, "post_id": 1111005, "parent": 0, "user": "jeff", "user_id": 185444, "date": "2026-10-15 05:54:56", "date_gmt": "2026-10-15 03:54:56", "date_gmt_iso": "2026-10-15T03:54:56+00:00", "content": "I used one of the really skinny allen wrenches from the side to stop the expansion joint from spinning while pushing the aligner in place. This is crazy.", "type": "comment", "role": "visitor", "replies": []}, {"id": 103635, "post_id": 1111005, "parent": 0, "user": "Patronics", "user_id": 108059, "date": "2026-10-12 09:44:04", "date_gmt": "2026-10-12 07:44:04", "date_gmt_iso": "2026-10-12T07:44:04+00:00", "content": "Don&#039;t fully tighten these yet! We&#039;re going to do a couple more passes of tightening each to balance out the pressure", "type": "comment", "role": "visitor", "replies": []}, {"id": 100200, "post_id": 1111005, "parent": 0, "user": "Brandon", "user_id": 91206, "date": "2026-09-01 07:14:47", "date_gmt": "2026-09-01 05:14:47", "date_gmt_iso": "2026-09-01T05:14:47+00:00", "content": "This is a good place to double check that the groove in the expansion joints is facing out from the center of the printer on eight.", "type": "comment", "role": "visitor", "replies": []}, {"id": 99888, "post_id": 1111005, "parent": 0, "user": "Paul", "user_id": 12004, "date": "2026-08-29 16:19:31", "date_gmt": "2026-08-29 14:19:31", "date_gmt_iso": "2026-08-29T14:19:31+00:00", "content": "If your holes in the heatbed and the expansion joints don&#039;t quite align, drop the 2mm hex key through and give it a wiggle", "type": "comment", "role": "visitor", "replies": [{"id": 103521, "post_id": 1111005, "parent": 99888, "user": "AL", "user_id": 212392, "date": "2026-10-10 20:38:15", "date_gmt": "2026-10-10 18:38:15", "date_gmt_iso": "2026-10-10T18:38:15+00:00", "content": "Second this", "type": "comment", "role": "visitor", "replies": []}]}]