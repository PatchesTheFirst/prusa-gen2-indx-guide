[{"id": 102085, "post_id": 1117086, "parent": 0, "user": "Jeremiah Moss", "user_id": 93185, "date": "2026-09-20 04:42:30", "date_gmt": "2026-09-20 02:42:30", "date_gmt_iso": "2026-09-20T02:42:30+00:00", "content": "I cannot for the life of me get this to any tightness with the tools I have.", "type": "comment", "role": "visitor", "replies": []}, {"id": 101275, "post_id": 1117086, "parent": 0, "user": "JBinFL", "user_id": 10750, "date": "2026-09-11 16:41:48", "date_gmt": "2026-09-11 14:41:48", "date_gmt_iso": "2026-09-11T14:41:48+00:00", "content": "see my comment at step 21 for  this.  the hole in the expansion joint has threads on it and can bind with the allen key.  i used a very thin flat blade screwdriver that the tip was wide enough to engage the M3x6r slots but thinner than the expansion joint hole to tighten without splitting...", "type": "comment", "role": "visitor", "replies": []}, {"id": 101115, "post_id": 1117086, "parent": 0, "user": "GaryB", "user_id": 164104, "date": "2026-09-10 01:03:58", "date_gmt": "2026-09-09 23:03:58", "date_gmt_iso": "2026-09-09T23:03:58+00:00", "content": "Yep +1. Very little pressure, and it split", "type": "comment", "role": "visitor", "replies": []}, {"id": 99757, "post_id": 1117086, "parent": 0, "user": "brandonlow27", "user_id": 148833, "date": "2026-08-28 06:38:25", "date_gmt": "2026-08-28 04:38:25", "date_gmt_iso": "2026-08-28T04:38:25+00:00", "content": "I was running the screw down and the part split when the screw was only run in about halfway. Evidently I should&#039;ve slowed down. Still seems usable but I&#039;m hoping Prusa posts files so I can print a replacement.", "type": "comment", "role": "visitor", "replies": [{"id": 100185, "post_id": 1117086, "parent": 99757, "user": "eliotik", "user_id": 107190, "date": "2026-09-01 01:02:53", "date_gmt": "2026-08-31 23:02:53", "date_gmt_iso": "2026-08-31T23:02:53+00:00", "content": "same here, hoping for files", "type": "comment", "role": "visitor", "replies": []}, {"id": 100588, "post_id": 1117086, "parent": 99757, "user": "c13m3n7", "user_id": 183020, "date": "2026-09-05 16:05:24", "date_gmt": "2026-09-05 14:05:24", "date_gmt_iso": "2026-09-05T14:05:24+00:00", "content": "same", "type": "comment", "role": "visitor", "replies": []}, {"id": 102355, "post_id": 1117086, "parent": 99757, "user": "Eric Coelho", "user_id": 81576, "date": "2026-09-23 19:49:18", "date_gmt": "2026-09-23 17:49:18", "date_gmt_iso": "2026-09-23T17:49:18+00:00", "content": "Thanks for the warning. I found screwing in a little then backing off like using a tap and die set worked well and didn&#039;t split.", "type": "comment", "role": "visitor", "replies": [{"id": 102472, "post_id": 1117086, "parent": 102355, "user": "Teejo", "user_id": 108571, "date": "2026-09-25 08:52:51", "date_gmt": "2026-09-25 06:52:51", "date_gmt_iso": "2026-09-25T06:52:51+00:00", "content": "Thanks, this method worked well. Tighten, loosen. Tighten a bit more, loosen, etc. Took a while, but didn&#039;t have problems.", "type": "comment", "role": "visitor", "replies": []}]}]}, {"id": 99624, "post_id": 1117086, "parent": 0, "user": "Seitan", "user_id": 203812, "date": "2026-08-24 19:30:44", "date_gmt": "2026-08-24 17:30:44", "date_gmt_iso": "2026-08-24T17:30:44+00:00", "content": "Same here, - the part screw is going into splits even on slightest force applied.", "type": "comment", "role": "visitor", "replies": []}, {"id": 99590, "post_id": 1117086, "parent": 0, "user": "Clete2", "user_id": 194344, "date": "2026-08-23 19:07:38", "date_gmt": "2026-08-23 17:07:38", "date_gmt_iso": "2026-08-23T17:07:38+00:00", "content": "Be exceedingly careful. I was careful and I still split the plastic because of the orientation this part was printed.", "type": "comment", "role": "visitor", "replies": []}]