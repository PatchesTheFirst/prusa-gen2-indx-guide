[{"id": 101485, "post_id": 1111108, "parent": 0, "user": "Trainman", "user_id": 19597, "date": "2026-09-13 17:11:13", "date_gmt": "2026-09-13 15:11:13", "date_gmt_iso": "2026-09-13T15:11:13+00:00", "content": "Removing the nozzle assembly gives you a good chance to inspect the nozzle and replace if need be", "type": "comment", "role": "visitor", "replies": []}, {"id": 99536, "post_id": 1111108, "parent": 0, "user": "lbab", "user_id": 168242, "date": "2026-08-22 07:50:04", "date_gmt": "2026-08-22 05:50:04", "date_gmt_iso": "2026-08-22T05:50:04+00:00", "content": "I had trouble removing the cable clip until I temporarily removed the upper thumb screw as well.", "type": "comment", "role": "visitor", "replies": [{"id": 99879, "post_id": 1111108, "parent": 99536, "user": "3Dmountains", "user_id": 183812, "date": "2026-08-29 14:54:28", "date_gmt": "2026-08-29 12:54:28", "date_gmt_iso": "2026-08-29T12:54:28+00:00", "content": "Same, and since I removed that, also disconnected to heater and removed it - for easier access.", "type": "comment", "role": "visitor", "replies": [{"id": 99891, "post_id": 1111108, "parent": 99879, "user": "ygram", "user_id": 106525, "date": "2026-08-29 17:04:49", "date_gmt": "2026-08-29 15:04:49", "date_gmt_iso": "2026-08-29T15:04:49+00:00", "content": "Yeah, removing the heater and both thumbscrews makes this much easier.", "type": "comment", "role": "visitor", "replies": []}]}, {"id": 100914, "post_id": 1111108, "parent": 99536, "user": "Harebourg", "user_id": 189808, "date": "2026-09-08 02:01:59", "date_gmt": "2026-09-08 00:01:59", "date_gmt_iso": "2026-09-08T00:01:59+00:00", "content": "Thanks! I loosened the top thumb screw and it gave enough leeway to pull out the clip", "type": "comment", "role": "visitor", "replies": []}]}]