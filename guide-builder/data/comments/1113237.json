[{"id": 102986, "post_id": 1113237, "parent": 0, "user": "TheKidFromCrumlin", "user_id": 101674, "date": "2026-10-03 12:11:54", "date_gmt": "2026-10-03 10:11:54", "date_gmt_iso": "2026-10-03T10:11:54+00:00", "content": "Correct, for INDX you do not need to do this screw yet. And when you get to it, it will haunt you :(", "type": "comment", "role": "visitor", "replies": []}, {"id": 100499, "post_id": 1113237, "parent": 0, "user": "sworcester", "user_id": 155744, "date": "2026-09-04 22:51:19", "date_gmt": "2026-09-04 20:51:19", "date_gmt_iso": "2026-09-04T20:51:19+00:00", "content": "With INDX, there&#039;s no main cable to go back into the clip (yet), correct?", "type": "comment", "role": "visitor", "replies": [{"id": 101412, "post_id": 1113237, "parent": 100499, "user": "ftess", "user_id": 72513, "date": "2026-09-13 01:07:04", "date_gmt": "2026-09-12 23:07:04", "date_gmt_iso": "2026-09-12T23:07:04+00:00", "content": "None.", "type": "comment", "role": "visitor", "replies": []}]}, {"id": 100408, "post_id": 1113237, "parent": 0, "user": "Nicholas Borge", "user_id": 170278, "date": "2026-09-03 20:33:23", "date_gmt": "2026-09-03 18:33:23", "date_gmt_iso": "2026-09-03T18:33:23+00:00", "content": "If doing INDX, no cable clip, correct?", "type": "comment", "role": "visitor", "replies": []}, {"id": 100407, "post_id": 1113237, "parent": 0, "user": "Nicholas Borge", "user_id": 170278, "date": "2026-09-03 20:32:31", "date_gmt": "2026-09-03 18:32:31", "date_gmt_iso": "2026-09-03T18:32:31+00:00", "content": "I think I stripped the motor mount screw a bit - is it essential that it is very secure if the other four 35mm screws are secure themselves?", "type": "comment", "role": "visitor", "replies": [{"id": 100605, "post_id": 1113237, "parent": 100407, "user": "Ben Dover", "user_id": 46415, "date": "2026-09-05 18:11:42", "date_gmt": "2026-09-05 16:11:42", "date_gmt_iso": "2026-09-05T16:11:42+00:00", "content": "Same here, my M3x6 was spinning freely.", "type": "comment", "role": "visitor", "replies": []}, {"id": 101027, "post_id": 1113237, "parent": 100407, "user": "k4rl5m1th", "user_id": 146433, "date": "2026-09-09 10:09:25", "date_gmt": "2026-09-09 08:09:25", "date_gmt_iso": "2026-09-09T08:09:25+00:00", "content": "mine spins freely also, any issues?", "type": "comment", "role": "visitor", "replies": []}, {"id": 101182, "post_id": 1113237, "parent": 100407, "user": "orangebird", "user_id": 128501, "date": "2026-09-10 22:18:33", "date_gmt": "2026-09-10 20:18:33", "date_gmt_iso": "2026-09-10T20:18:33+00:00", "content": "Same here", "type": "comment", "role": "visitor", "replies": []}, {"id": 102153, "post_id": 1113237, "parent": 100407, "user": "Hallsville3", "user_id": 152210, "date": "2026-09-20 20:14:51", "date_gmt": "2026-09-20 18:14:51", "date_gmt_iso": "2026-09-20T18:14:51+00:00", "content": "Same!", "type": "comment", "role": "visitor", "replies": []}, {"id": 102658, "post_id": 1113237, "parent": 100407, "user": "Celta", "user_id": 3085, "date": "2026-09-27 13:24:19", "date_gmt": "2026-09-27 11:24:19", "date_gmt_iso": "2026-09-27T11:24:19+00:00", "content": "I disassembled just to double check, the M3x6 only grips the printed part, no nut placed or room for it.", "type": "comment", "role": "visitor", "replies": [{"id": 103158, "post_id": 1113237, "parent": 102658, "user": "jliss", "user_id": 175342, "date": "2026-10-05 00:17:56", "date_gmt": "2026-10-04 22:17:56", "date_gmt_iso": "2026-10-04T22:17:56+00:00", "content": "Thank you for this check. I also checked. Poorly written steps. Mine swims too but ok. Probably over design with 5 screws.\nThis entire documentation is worse then the original build. I&#039;m a retired engineer and I can say this is a good attempt by Prusa, but the documentation was NOT system tested.", "type": "comment", "role": "visitor", "replies": []}]}, {"id": 102701, "post_id": 1113237, "parent": 100407, "user": "Ivy J", "user_id": 99933, "date": "2026-09-28 00:42:26", "date_gmt": "2026-09-27 22:42:26", "date_gmt_iso": "2026-09-27T22:42:26+00:00", "content": "same", "type": "comment", "role": "visitor", "replies": []}, {"id": 102786, "post_id": 1113237, "parent": 100407, "user": "HoryAycardo", "user_id": 37206, "date": "2026-09-29 08:57:22", "date_gmt": "2026-09-29 06:57:22", "date_gmt_iso": "2026-09-29T06:57:22+00:00", "content": "Same", "type": "comment", "role": "visitor", "replies": []}, {"id": 103174, "post_id": 1113237, "parent": 100407, "user": "jiblett1000", "user_id": 165480, "date": "2026-10-05 03:48:01", "date_gmt": "2026-10-05 01:48:01", "date_gmt_iso": "2026-10-05T01:48:01+00:00", "content": "So this screw spinning is ok? ridiculous design. Not sure I can even continue with these instructions.....so now I have a disassembled printer I can&#039;t use indefinitely.\n\nUPDATE: \n\nJust talked to support. Apparently that screw spinning freely is not a huge deal as the other screws hold it secure as well. So the red warning text in the instructions is perhaps a bit much.", "type": "comment", "role": "visitor", "replies": []}]}, {"id": 99249, "post_id": 1113237, "parent": 0, "user": "iftibashir", "user_id": 81489, "date": "2026-08-14 14:13:40", "date_gmt": "2026-08-14 12:13:40", "date_gmt_iso": "2026-08-14T12:13:40+00:00", "content": "First step here should should read FOUR M3x30 screws - not ONE?", "type": "comment", "role": "visitor", "replies": [{"id": 99390, "post_id": 1113237, "parent": 99249, "user": "Vojta Zeman", "user_id": 83180, "date": "2026-08-18 07:31:30", "date_gmt": "2026-08-18 05:31:30", "date_gmt_iso": "2026-08-18T05:31:30+00:00", "content": "Good point. Thank you. Fixed.", "type": "comment", "role": "employee", "replies": []}]}]