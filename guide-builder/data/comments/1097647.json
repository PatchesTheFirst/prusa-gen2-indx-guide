[{"id": 102315, "post_id": 1097647, "parent": 0, "user": "Skirfir", "user_id": 91884, "date": "2026-09-23 09:20:16", "date_gmt": "2026-09-23 07:20:16", "date_gmt_iso": "2026-09-23T07:20:16+00:00", "content": "If you are afraid of cutting any wires you can cut through the head of the ziptie instead.", "type": "comment", "role": "visitor", "replies": []}, {"id": 101890, "post_id": 1097647, "parent": 0, "user": "Danshari", "user_id": 127633, "date": "2026-09-19 03:07:56", "date_gmt": "2026-09-19 01:07:56", "date_gmt_iso": "2026-09-19T01:07:56+00:00", "content": "same as Steve, that was the instructed assembly for the +\n\nI retied without the thermistor, but then in the next instruction I had to cut it again\n\nJust ignore them and cut all the zip ties", "type": "comment", "role": "visitor", "replies": []}, {"id": 100948, "post_id": 1097647, "parent": 0, "user": "k4rl5m1th", "user_id": 146433, "date": "2026-09-08 11:12:46", "date_gmt": "2026-09-08 09:12:46", "date_gmt_iso": "2026-09-08T09:12:46+00:00", "content": "same", "type": "comment", "role": "visitor", "replies": []}, {"id": 100822, "post_id": 1097647, "parent": 0, "user": "Steve Stratoti", "user_id": 209860, "date": "2026-09-07 06:11:28", "date_gmt": "2026-09-07 04:11:28", "date_gmt_iso": "2026-09-07T04:11:28+00:00", "content": "My Heatbed Thermistor Cable is ziptied all the way to the bottom on the right side. The second image shows it hanging free. My CoreOne+ was delivered assembled. I&#039;m assuming we remove the zip ties, they aren&#039;t shown in the next step.", "type": "comment", "role": "visitor", "replies": []}, {"id": 99961, "post_id": 1097647, "parent": 0, "user": "Olle W", "user_id": 20927, "date": "2026-08-30 12:17:47", "date_gmt": "2026-08-30 10:17:47", "date_gmt_iso": "2026-08-30T10:17:47+00:00", "content": "I needed to cut the lower zip tie that is marked with an X to be able to remove the thermistor cable.", "type": "comment", "role": "visitor", "replies": [{"id": 100821, "post_id": 1097647, "parent": 99961, "user": "Steve Stratoti", "user_id": 209860, "date": "2026-09-07 06:09:50", "date_gmt": "2026-09-07 04:09:50", "date_gmt_iso": "2026-09-07T04:09:50+00:00", "content": "same.", "type": "comment", "role": "visitor", "replies": []}, {"id": 101043, "post_id": 1097647, "parent": 99961, "user": "Andreas Dybdahl", "user_id": 218247, "date": "2026-09-09 14:17:43", "date_gmt": "2026-09-09 12:17:43", "date_gmt_iso": "2026-09-09T12:17:43+00:00", "content": "same here", "type": "comment", "role": "visitor", "replies": []}]}, {"id": 99781, "post_id": 1097647, "parent": 0, "user": "Spin360", "user_id": 90158, "date": "2026-08-28 14:16:07", "date_gmt": "2026-08-28 12:16:07", "date_gmt_iso": "2026-08-28T12:16:07+00:00", "content": "Cutting those zip ties had me sweating", "type": "comment", "role": "visitor", "replies": []}]